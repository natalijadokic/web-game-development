raw_data = read_csv("data/edge1.1.csv")
# TODO: "Warning: One or more parsing issues, call `problems()` on your data frame for details, e.g.:
# dat <- vroom(...)
# problems(dat)"
game = multiverse()
particip_data_duplicates = raw_data %>%
dplyr::select(!Order:Number.Characters)|>
group_by(ThreadId, Id) %>%
summarize(across(Type:ContributionsbyAuthor,  ~ paste(unique(.x), collapse = "; ")))
particip_data_filt = particip_data_duplicates %>%
filter(if_any(Type:ContributionsbyAuthor, ~ grepl(";", .x)))
raw_data = anti_join(raw_data, particip_data_filt,  by = c("ThreadId", "Id"))
raw_data = raw_data %>%
mutate(percent_by_author = ContributionsbyAuthor/ DebateSize, .after = ContributionsbyAuthor)
execute_multiverse(game, progress = TRUE)
results_n4 = extract_variables(game, data_filtered2)
eighteen <- results_n4$data_filtered2[[18]]     # df from the 9th universe
# Scatterplot function <- DV-IV relationship
plot_scatter <- function(df, dv, iv) {
ggplot(df, aes(x = .data[[iv]], y = .data[[dv]])) +
geom_point(alpha = 0.4) +
theme_bw() +
labs(x = iv, y = dv,
title = "Relationship between the dependent and independent variable")
}
# distribution of the DV and the IV
plot_dist <- function(df, var, bw, ds) {
ggplot(df, aes(x = .data[[var]])) +
geom_dotplot(binwidth = bw, dotsize = ds, method = "histodot", stackratio = 1) +
theme_bw() +
labs(x = var, y = NULL, title = paste("Distribution of", var))
}
# Parameter function, used when scaling the x and y axes dynamically
dot_params <- function(x, n_bins = 60, aspect = 2) { # aspect: panel width/height
bw <- diff(range(x, na.rm = TRUE)) / n_bins # x axis is cut into 60 bins (so that the binwidth is dynamic, however, the number of bins is 60 either way, regardless of the scale)
max_stack <- max(table(floor((x - min(x, na.rm = TRUE)) / bw))) # the size of the tallest pile:
list(bw = bw, ds = min(1, 0.8 * n_bins / (max_stack * aspect))) # d of dot: bw * ds. the tallest pile: max_stack * ds * bw. height of panel: n_bins * bw / 2 (bc. of the assumed proportion of panel width / height).
}
# dv-iv separation
split_dv_iv <- function(x) {
if (str_starts(x, "percent")) {
dv <- "percent_by_author"
iv <- str_remove(x, "^percent_by_author_")
} else {
dv <- str_extract(x, "^[^_]+")
iv <- str_remove(x, "^[^_]+_")
}
fix <- function(v) if_else(v == "FemaleContributions", "Female_Contributions", v)
list(dv = fix(dv), iv = fix(iv))
}
# variable selection
get_dv_iv <- function(data) {
cols <- setdiff(names(data), c("ThreadId", "Id", "Type"))
list(dv = cols[1], iv = cols[2]) # output = list, function removes all cols but dv and iv, and then selects them. alternative option, used in the multiverse chunk
}
multiverse::execute_multiverse(game)
plots_tbl <- multiverse::expand(game) %>%
dplyr::transmute(
.universe,
dv_iv_plots = purrr::map(.results, ~ .x$dv_iv_plot),
dv_plots = purrr::map(.results, ~ .x$dv_plot),
iv_plots = purrr::map(.results, ~ .x$iv_plot)
)
results_n5 <- results_n4 %>%
dplyr::select(-any_of(c("dv_iv_plots", "dv_plots", "iv_plots"))) %>%
left_join(plots_tbl, by = ".universe") %>%
mutate(across(c(dv_iv_plots, dv_plots, iv_plots),
~ map2(.x, .universe, ~ .x + labs(subtitle = paste("Universe", .y)))))
View(results_n4)
results_n5$dv_plots[[1]]   # scatterplot of universe in row 1
results_n5$dv_plots[[32]]   # scatterplot of universe in row 1
results_n5$dv_plots[[39]]   # scatterplot of universe in row 1
results_n5$dv_plots[[50]]   # scatterplot of universe in row 1
results_n5$dv_plots[[44]]   # scatterplot of universe in row 1
results_n5$dv_plots[[22]]   # scatterplot of universe in row 1
results_n5$dv_plots[[3]]   # scatterplot of universe in row 1
?sd
